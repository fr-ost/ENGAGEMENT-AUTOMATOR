# Railway: add these under the service's Variables tab. Locally: export them before `python bot.py`.

TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_OWNER_ID=             # your numeric Telegram user ID; only this user can place orders
SMM_API_KEY=                   # BulkFollows -> Account Settings
SMM_VIEW_SERVICE_ID=           # a "Default"-type views/impressions service
SMM_LIKE_SERVICE_ID=           # a "Default"-type likes service

# Optional
# SMM_API_URL=https://bulkfollows.com/api/v2
# DATA_DIR=/data               # on Railway: the mount path of the volume
# DEFAULT_VIEWS=1000           # starting defaults; change later with /views and /likes
# DEFAULT_LIKES=30
# SPREAD_HOURS=12              # change later with /spread
# MAX_VIEWS=100000             # per-link safety limits against typos
# MAX_LIKES=5000
